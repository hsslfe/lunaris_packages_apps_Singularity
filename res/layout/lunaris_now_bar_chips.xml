<?xml version="1.0" encoding="utf-8"?>
<!-- Dedicated preference row: prevent title/chips sharing framework widget IDs and
     reserve sufficient measured space between adjacent Settings cards. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="?android:attr/listPreferredItemPaddingStart"
    android:paddingEnd="?android:attr/listPreferredItemPaddingEnd"
    android:paddingTop="16dp"
    android:paddingBottom="22dp">

    <TextView
        android:id="@+id/now_bar_preference_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:includeFontPadding="true"
        android:textAppearance="?android:attr/textAppearanceListItem" />

    <TextView
        android:id="@+id/now_bar_preference_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:includeFontPadding="true"
        android:textAppearance="?android:attr/textAppearanceListItemSecondary"
        android:textColor="?android:attr/textColorSecondary"
        android:visibility="gone" />

    <org.lunaris.settings.preferences.NowBarFlowLayout
        android:id="@+id/now_bar_chips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="4dp" />
</LinearLayout>
