<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingTop="16dp"
    android:paddingBottom="28dp"
    android:background="@color/singularity_background">
    <ImageButton
        android:id="@+id/singularity_back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:minWidth="48dp"
        android:minHeight="48dp"
        android:padding="14dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/singularity_circle_background"
        android:src="@drawable/ic_singularity_back"
        android:contentDescription="@string/singularity_back" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:text="@string/lunaris_dashboard_title"
        android:textColor="@color/singularity_text_primary"
        android:textSize="28sp"
        android:accessibilityHeading="true"
        android:textStyle="bold" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="22dp"
        android:text="@string/singularity_subtitle"
        android:textColor="@color/singularity_text_secondary"
        android:textSize="13sp" />
    <FrameLayout
        android:id="@+id/singularity_lockscreen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="88dp"
        android:background="@drawable/singularity_card_background"
        android:foreground="?android:attr/selectableItemBackground"
        android:clipToOutline="true"
        android:focusable="true"
        android:clickable="true">
        <org.lunaris.settings.utils.LockscreenWallpaperPreviewView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:id="@+id/singularity_lock_wallpaper" />
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/singularity_wallpaper_dim"
            android:importantForAccessibility="no"
            android:id="@+id/singularity_lock_dim"
            android:alpha="0.3" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_gravity="center_vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        style="@style/SingularityCardTitle"
                        android:text="@string/singularity_lockscreen"
                        android:textSize="15sp"
                        android:textColor="@android:color/white"
                        android:shadowColor="#99000000"
                        android:shadowRadius="2"
                        android:shadowDy="1" />
                    <TextClock
                        android:id="@+id/singularity_lock_clock"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif-medium"
                        android:format12Hour="hh:mm"
                        android:format24Hour="HH:mm"
                        android:maxLines="1"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="20sp"
                        android:autoSizeMaxTextSize="30sp"
                        android:autoSizeStepGranularity="1sp"
                        android:textColor="@android:color/white"
                        android:textSize="30sp"
                        android:importantForAccessibility="no"
                        android:shadowColor="#99000000"
                        android:shadowRadius="2"
                        android:shadowDy="1" />
                </LinearLayout>
                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/singularity_lock_icon_background"
                    android:padding="12dp"
                    android:src="@drawable/ic_singularity_lock"
                    android:importantForAccessibility="no"
                    android:tint="@android:color/white" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/singularity_card_background"
        android:clipToOutline="true"
        android:orientation="vertical">
        <include
            android:id="@+id/singularity_monet"
            layout="@layout/singularity_dashboard_row" />
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="18dp"
            android:background="@color/singularity_divider" />
        <include
            android:id="@+id/singularity_wallpapers"
            layout="@layout/singularity_dashboard_row" />
    </LinearLayout>
    <include
        android:id="@+id/singularity_themes"
        layout="@layout/singularity_dashboard_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal"
        android:baselineAligned="false">
        <include
            android:id="@+id/singularity_statusbar"
            layout="@layout/singularity_dashboard_small_row"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />
        <Space
            android:layout_width="10dp"
            android:layout_height="1dp" />
        <include
            android:id="@+id/singularity_qs"
            layout="@layout/singularity_dashboard_small_row"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />
    </LinearLayout>
    <include
        android:id="@+id/singularity_aod"
        layout="@layout/singularity_dashboard_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal"
        android:baselineAligned="false">
        <include
            android:id="@+id/singularity_buttons"
            layout="@layout/singularity_dashboard_tile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />
        <Space
            android:layout_width="9dp"
            android:layout_height="1dp" />
        <include
            android:id="@+id/singularity_power"
            layout="@layout/singularity_dashboard_tile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />
        <Space
            android:layout_width="9dp"
            android:layout_height="1dp" />
        <include
            android:id="@+id/singularity_notifications"
            layout="@layout/singularity_dashboard_tile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:orientation="horizontal"
        android:baselineAligned="false">
        <include
            android:id="@+id/singularity_navigation"
            layout="@layout/singularity_dashboard_small_row"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />
        <Space
            android:layout_width="9dp"
            android:layout_height="1dp" />
        <include
            android:id="@+id/singularity_misc"
            layout="@layout/singularity_dashboard_small_row"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />
    </LinearLayout>
    <!-- Keep the original sound settings accessible alongside the new shortcuts. -->
    <include
        android:id="@+id/singularity_sound"
        layout="@layout/singularity_dashboard_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp" />
</LinearLayout>
