<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="60dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:focusable="true"
    android:clickable="true"
    android:background="@drawable/singularity_card_background">
    <ImageView
        android:id="@+id/singularity_card_icon"
        style="@style/SingularityCardIcon"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:padding="9dp" />
    <TextView
        android:id="@+id/singularity_card_title"
        style="@style/SingularityCardTitle"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:textSize="13sp" />
    <ImageView
        style="@style/SingularityCardArrow"
        android:layout_width="12dp"
        android:layout_marginStart="2dp" />
</LinearLayout>
