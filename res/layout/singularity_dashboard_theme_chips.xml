<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical">
    <ImageButton
        android:id="@+id/singularity_theme_store"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:padding="13dp"
        android:background="@drawable/singularity_theme_chip"
        android:src="@drawable/ic_singularity_person"
        android:contentDescription="@string/singularity_theme_packs" />
    <TextView
        android:id="@+id/singularity_fonts"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:gravity="center"
        android:text="@string/singularity_font_preview"
        android:textColor="@color/singularity_text_primary"
        android:textSize="17sp"
        android:fontFamily="sans-serif-medium"
        android:focusable="true"
        android:clickable="true"
        android:background="@drawable/singularity_card_background"
        android:contentDescription="@string/font_settings_title" />
</LinearLayout>
