<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:title="@string/now_bar_title">

    <lineageos.preference.SystemSettingMainSwitchPreference
        android:key="now_bar"
        android:title="@string/now_bar_title"
        android:summary="@string/now_bar_summary"
        android:defaultValue="false" />

    <lineageos.preference.SystemSettingSwitchPreference
        android:key="now_bar_coloros_swipe_up"
        android:title="@string/now_bar_coloros_swipe_up"
        android:summary="@string/now_bar_coloros_swipe_up_summary"
        android:defaultValue="true"
        android:dependency="now_bar" />

    <PreferenceCategory
        android:key="now_bar_looks_category"
        android:title="@string/now_bar_looks"
        android:dependency="now_bar">
        <org.lunaris.settings.preferences.NowBarChipsPreference
            android:key="now_bar_look"
            android:entries="@array/now_bar_looks_entries" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="now_bar_style"
        android:title="@string/now_bar_style"
        android:dependency="now_bar">
        <org.lunaris.settings.preferences.NowBarChipsPreference
            android:key="now_bar_material"
            android:title="@string/now_bar_material"
            android:entries="@array/now_bar_material_entries"
            android:entryValues="@array/now_bar_two_values"
            android:defaultValue="1" />
        <org.lunaris.settings.preferences.NowBarChipsPreference
            android:key="now_bar_color"
            android:title="@string/now_bar_color"
            android:entries="@array/now_bar_color_entries"
            android:entryValues="@array/now_bar_three_values"
            android:defaultValue="1" />
        <org.lunaris.settings.preferences.SystemSettingSeekBarPreference
            android:key="now_bar_opacity"
            android:title="@string/now_bar_opacity"
            android:defaultValue="100"
            android:max="100"
            app:min="0"
            app:updatesContinuously="true" />
        <org.lunaris.settings.preferences.NowBarChipsPreference
            android:key="now_bar_outline"
            android:title="@string/now_bar_outline"
            android:entries="@array/now_bar_outline_entries"
            android:entryValues="@array/now_bar_three_values"
            android:defaultValue="1" />
        <org.lunaris.settings.preferences.NowBarChipsPreference
            android:key="now_bar_shadow"
            android:title="@string/now_bar_shadow"
            android:entries="@array/now_bar_shadow_entries"
            android:entryValues="@array/now_bar_three_values"
            android:defaultValue="0" />
        <org.lunaris.settings.preferences.NowBarChipsPreference
            android:key="now_bar_more"
            android:title="@string/now_bar_more"
            android:entries="@array/now_bar_more_entries"
            android:entryValues="@array/now_bar_three_values"
            android:defaultValue="0" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="now_bar_size"
        android:title="@string/now_bar_size"
        android:dependency="now_bar">
        <org.lunaris.settings.preferences.SystemSettingSeekBarPreference
            android:key="now_bar_height"
            android:title="@string/now_bar_height"
            android:defaultValue="58"
            android:max="96"
            app:min="48"
            app:updatesContinuously="true" />
        <org.lunaris.settings.preferences.SystemSettingSeekBarPreference
            android:key="now_bar_width"
            android:title="@string/now_bar_width"
            android:summary="@string/now_bar_width_summary"
            android:defaultValue="180"
            android:max="420"
            app:min="120"
            app:updatesContinuously="true" />
        <org.lunaris.settings.preferences.SystemSettingSeekBarPreference
            android:key="now_bar_corners"
            android:title="@string/now_bar_corners"
            android:defaultValue="100"
            android:max="100"
            app:min="20"
            app:updatesContinuously="true" />
        <org.lunaris.settings.preferences.SystemSettingSeekBarPreference
            android:key="now_bar_raise"
            android:title="@string/now_bar_raise"
            android:defaultValue="0"
            android:max="40"
            app:min="0"
            app:updatesContinuously="true" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="now_bar_music_category"
        android:title="@string/now_bar_music_category"
        android:dependency="now_bar">
        <org.lunaris.settings.preferences.NowBarChipsPreference
            android:key="now_bar_art"
            android:title="@string/now_bar_art"
            android:entries="@array/now_bar_art_entries"
            android:entryValues="@array/now_bar_four_values"
            android:defaultValue="0" />
        <org.lunaris.settings.preferences.NowBarChipsPreference
            android:key="now_bar_buttons"
            android:title="@string/now_bar_buttons"
            android:entries="@array/now_bar_buttons_entries"
            android:entryValues="@array/now_bar_three_values"
            android:defaultValue="1" />
        <org.lunaris.settings.preferences.NowBarChipsPreference
            android:key="now_bar_text"
            android:title="@string/now_bar_text"
            android:entries="@array/now_bar_text_entries"
            android:entryValues="@array/now_bar_three_values"
            android:defaultValue="1" />
        <org.lunaris.settings.preferences.SystemSettingSeekBarPreference
            android:key="now_bar_text_size"
            android:title="@string/now_bar_text_size"
            android:defaultValue="13"
            android:max="17"
            app:min="11"
            app:updatesContinuously="true" />
        <lineageos.preference.SystemSettingSwitchPreference
            android:key="now_bar_scroll_text"
            android:title="@string/now_bar_scroll_text"
            android:summary="@string/now_bar_scroll_text_summary"
            android:defaultValue="true" />
        <lineageos.preference.SystemSettingSwitchPreference
            android:key="now_bar_wave"
            android:title="@string/now_bar_wave"
            android:defaultValue="false" />
    </PreferenceCategory>


    <PreferenceCategory
        android:key="now_bar_show_category"
        android:title="@string/now_bar_show"
        android:dependency="now_bar">
        <Preference
            android:key="now_bar_show_page"
            android:title="@string/now_bar_show_page"
            android:summary="@string/now_bar_show_page_summary"
            android:fragment="org.lunaris.settings.fragments.lockscreen.NowBarShowSettings" />
    </PreferenceCategory>

    <com.android.settingslib.widget.FooterPreference
        android:key="now_bar_footer"
        android:title="@string/now_bar_footer"
        android:selectable="false" />
</PreferenceScreen>
